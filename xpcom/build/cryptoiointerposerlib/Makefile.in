include $(topsrcdir)/config/config.mk
include $(topsrcdir)/config/rules.mk
ifeq (cocoa,$(MOZ_WIDGET_TOOLKIT)) #{
libs::
	# Install lib to a location in the DYLIB search path for tests.
	$(NSINSTALL) -D $(topobjdir)/_tests/testing/mochitest
	cp $(DIST)/bin/libcryptoiointerposer.dylib $(topobjdir)/_tests/testing/mochitest/
endif #}
